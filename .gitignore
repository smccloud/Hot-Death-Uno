# Build output
# Note: unanchored, because the Gradle module sits at com.smccloud.hotdeath/app --
# an "app/release/" pattern would only match at the repo root.
build/
release/
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
bin/
gen/
out/
proguard/

# Gradle
.gradle/
.kotlin/

# Local configuration -- contains an absolute SDK path, machine-specific
local.properties

# Local CI helper. The Jenkinsfile is tracked; this is a personal client with a
# hardcoded controller URL, so it stays local. jenkins-creds.xml holds the API
# token as a DPAPI-encrypted PSCredential -- it must never be committed, and DPAPI
# ties it to this user on this machine anyway.
/jenkins.ps1
/jenkins-creds.xml

# Signing material. These must never be committed.
*.jks
*.keystore

# IDE
.idea/
*.iml
.navigation/
captures/
.externalNativeBuild
.cxx/
.vscode/

# Logs and profiling
*.log
*.hprof

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Merge and editor leftovers
*.orig
*.rej
*.swp
*~
