# Build output
# Note: unanchored, because the Gradle module sits at com.smccloud.hotdeath/app --
# an "app/release/" pattern would only match at the repo root.
build/
release/
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
bin/
gen/
out/
proguard/

# Gradle
.gradle/
.kotlin/

# Local configuration -- contains an absolute SDK path, machine-specific
local.properties

# Local CI helper. The Jenkinsfile and jenkins.sh are tracked; this is the
# PowerShell predecessor of jenkins.sh and it stays local. jenkins-creds.xml
# held the API token as a DPAPI-encrypted PSCredential -- it must never be
# committed, and DPAPI ties it to this user on this machine anyway. jenkins.sh
# is tracked because its controller URL is only a default that the environment
# or the creds file overrides, but jenkins-creds holds a plain API token, so
# that one must never be committed either.
/jenkins.ps1
/jenkins-creds.xml
/jenkins-creds

# A GitHub token, stored the same way: DPAPI-encrypted to this user on this
# machine, written by a one-liner the maintainer runs once. It needs write
# access to releases to upload an APK to a tag, which is why it cannot be a
# read-only token and why it is worth keeping out of git rather than in it.
/github-creds.xml

# Signing material. These must never be committed.
*.jks
*.keystore
# The properties file next to them: four plaintext passwords. It has no
# extension, so neither rule above covers it, and it looks like ordinary
# configuration -- which is what makes it the one most likely to be committed by
# accident. Unanchored, because it lives in the Gradle module at
# com.smccloud.hotdeath/app/, not at the repo root.
keystore.properties
# Android Studio's "export signing config" writes an encrypted copy beside the
# key. Same secrets, different extension.
*.properties.asc

# IDE
.idea/
*.iml
.navigation/
captures/
.externalNativeBuild
.cxx/
.vscode/

# Logs and profiling
*.log
*.hprof

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Merge and editor leftovers
*.orig
*.rej
*.swp
*~
