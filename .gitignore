# Build output
# Note: unanchored, because the Gradle module sits at com.runtsoft.hotdeath/app --
# an "app/release/" pattern would only match at the repo root.
build/
release/
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
bin/
gen/
out/
proguard/

# Gradle
.gradle/
.kotlin/

# Local configuration -- contains an absolute SDK path, machine-specific
local.properties

# Signing material. These must never be committed.
*.jks
*.keystore

# IDE
.idea/
*.iml
.navigation/
captures/
.externalNativeBuild
.cxx/
.vscode/

# Logs and profiling
*.log
*.hprof

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Merge and editor leftovers
*.orig
*.rej
*.swp
*~
